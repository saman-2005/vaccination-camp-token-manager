#include <iostream>
#include <fstream>
#include <cstring>
#include <limits>
using namespace std;

struct FileRecord {
    int tokennumber;
    char name[50];
    int age;
    char vaccine[30];
};
class vaccination {
private:
    int tokennumber;
    char name[50];
    int age;
    char vaccine[30];
    static int totalRecords;

public:
    // Default Constructor
    vaccination() {
        tokennumber = 0;
        age = 0;
        strcpy(name, "");
        strcpy(vaccine, "");
    }
    // Parameterized Constructor
    vaccination(int t, const char n[], int a, const char v[]) {
        tokennumber = t;
        age = a;
        strncpy(name, n, 49);
        name[49] = '\0';
        strncpy(vaccine, v, 29);
        vaccine[29] = '\0';
    }
    // Copy Constructor
    vaccination(const vaccination &obj) {
        tokennumber = obj.tokennumber;
        age = obj.age;
        strcpy(name, obj.name);
        strcpy(vaccine, obj.vaccine);
    }
    // Destructor
    ~vaccination() {
    }
    // Convert object into file record
    FileRecord getFileRecord() const {
        FileRecord record;
        record.tokennumber = tokennumber;
        record.age = age;
        strcpy(record.name, name);
        strcpy(record.vaccine, vaccine);
        return record;
    }
    // Load file record into object
    void setFileRecord(FileRecord record) {
        tokennumber = record.tokennumber;
        age = record.age;
        strcpy(name, record.name);
        strcpy(vaccine, record.vaccine);
    }
    int getToken() const {
        return tokennumber;
    }
    void display() const {
        cout << "\nToken Number: " << tokennumber;
        cout << "\nName: " << name;
        cout << "\nAge: " << age;
        cout << "\nVaccine: " << vaccine << endl;
    }
    static void increaseTotal() {
        totalRecords++;
    }

    static int getTotal() {
        return totalRecords;
    }
};

int vaccination::totalRecords = 0;
// Search Token using seekg()
bool searchToken(int token) {
    fstream file("tokens.dat", ios::in | ios::binary);

    if (!file) {
        cout << "\nFile not found!";
        return false;
    }
    FileRecord record;
    int index = 0;
    while (true) {
        file.seekg(index * sizeof(FileRecord), ios::beg);

        if (!file.read((char*)&record, sizeof(record))) {
            break;
        }
        if (record.tokennumber == token) {
            vaccination obj;
            obj.setFileRecord(record);
            cout << "\nRecord Found!";
            obj.display();
            file.close();
            return true;
        }
        index++;
    }
    file.close();
    cout << "\nToken Not Found!";
    return false;
}
// Add New Token
void addToken() {
    int token, age;
    char name[50], vaccine[30];

    cout << "\nEnter Token Number: ";
    cin >> token;

    if (cin.fail()) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "\nInvalid Token Number!";
        return;
    }

    if (token <= 0) {
        cout << "\nInvalid Token Number!";
        return;
    }

    // Check Duplicate Token
    fstream check("tokens.dat", ios::in | ios::binary);
    FileRecord record;
    bool duplicate = false;
    if (check) {
        while (check.read((char*)&record, sizeof(record))) {
            if (record.tokennumber == token) {
                duplicate = true;
                break;
            }
        }
    }
    check.close();

    if (duplicate) {
        cout << "\nDuplicate Token Number!";
        return;
    }

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Enter Beneficiary Name: ";
    cin.getline(name, 50);

    cout << "Enter Age: ";
    cin >> age;

    if (cin.fail()) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "\nInvalid Age!";
        return;
    }

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Enter Vaccine Name: ";
    cin.getline(vaccine, 30);

    if (age <= 0 || strlen(name) == 0 || strlen(vaccine) == 0) {
        cout << "\nInvalid Details!";
        return;
    }
    vaccination obj(token, name, age, vaccine);
    vaccination copyObj(obj);
    FileRecord newRecord = copyObj.getFileRecord();

    // Write Binary Record
    fstream file("tokens.dat", ios::out | ios::app | ios::binary);
    if (!file) {
        cout << "\nUnable to open file!";
        return;
    }
    file.write((char*)&newRecord, sizeof(newRecord));
    file.close();

    vaccination::increaseTotal();
    cout << "\nToken Registered Successfully!";
}

// View All Tokens
void viewTokens() {
    fstream file("tokens.dat", ios::in | ios::binary);

    if (!file) {
        cout << "\nNo Records Found!";
        return;
    }
    FileRecord record;
    int count = 0;
    cout << "\n===== VACCINATION RECORDS =====\n";

    while (file.read((char*)&record, sizeof(record))) {
        vaccination obj;
        obj.setFileRecord(record);
        obj.display();
        count++;
    }
    cout << "\nTotal Records: " << count;
    file.close();
}

// Update Token using seekp()
void updateToken() {
    int token;
    cout << "\nEnter Token Number to Update: ";
    cin >> token;

    if (cin.fail()) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "\nInvalid Token Number!";
        return;
    }

    fstream file("tokens.dat", ios::in | ios::out | ios::binary);

    if (!file) {
        cout << "\nFile Not Found!";
        return;
    }

    FileRecord record;
    int index = 0;
    bool found = false;
    while (true) {
        file.seekg(index * sizeof(FileRecord), ios::beg);

        if (!file.read((char*)&record, sizeof(record))) {
            break;
        }

        if (record.tokennumber == token) {
            found = true;
            break;
        }

        index++;
    }
    if (!found) {
        cout << "\nToken Not Found!";
        file.close();
        return;
    }
    char name[50], vaccine[30];
    int age;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Enter Updated Name: ";
    cin.getline(name, 50);

    cout << "Enter Updated Age: ";
    cin >> age;

    if (cin.fail()) {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "\nInvalid Age!";
        file.close();
        return;
    }
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
    cout << "Enter Updated Vaccine: ";
    cin.getline(vaccine, 30);
    if (age <= 0 || strlen(name) == 0 || strlen(vaccine) == 0) {
        cout << "\nInvalid Details!";
        file.close();
        return;
    }
    vaccination obj(token, name, age, vaccine);
    FileRecord updatedRecord = obj.getFileRecord();

    // Move Output Pointer using seekp()
    file.seekp(index * sizeof(FileRecord), ios::beg);
    file.write((char*)&updatedRecord, sizeof(updatedRecord));
    file.close();
    cout << "\nRecord Updated Successfully!";
}

